# Copy to .env and adjust. Every value is optional: with nothing set, the app runs fully offline
# (local JSON store + offline rule engine), which is the safest mode for a stage demo.
PORT=4000

# ─── Storage ───
# Leave empty to use the local JSON store at backend/data/db.json.
# Atlas: Database → Connect → Drivers, copy the connection string and put your password in it.
# If your network times out on the DNS SRV/TXT lookup that mongodb+srv:// needs, use the standard
# (non-SRV) address instead, which lists the three shard hosts:
#   mongodb://<user>:<password>@<cluster>-shard-00-00.<id>.mongodb.net:27017,<cluster>-shard-00-01.<id>.mongodb.net:27017,<cluster>-shard-00-02.<id>.mongodb.net:27017/?tls=true&authSource=admin&replicaSet=<replica-set>&retryWrites=true&w=majority&appName=<app>
# Check the connection with: npm --prefix backend run db:check
MONGODB_URI=
MONGODB_DB=prior_auth_copilot

# ─── LLM provider: auto | mistral | claude | groq | ollama | rules ───
#   auto  = Claude if ANTHROPIC_API_KEY is set, else Mistral, else Groq, else the offline rules engine
#   rules = deterministic offline engine (no network, no key)
LLM_PROVIDER=auto

# Mistral (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-3b-2512

# Groq (https://console.groq.com/keys). GROQ_MODEL must be a model listed in your Groq console.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# schema = JSON-schema structured output (falls back automatically) | object = JSON mode only
GROQ_JSON_MODE=schema

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Ollama (local models, no key)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Model that reads scanned reports, photos and scanned PDFs. Empty = provider default
# (Claude / Mistral: the same model; Groq: meta-llama/llama-4-scout-17b-16e-instruct; Ollama: OLLAMA_VISION_MODEL).
# With no LLM configured, scans are read with offline OCR (Tesseract; downloads ~10 MB of language data once).
VISION_MODEL=

# rules (default) = rule checks decide criteria verdicts, LLM gives a second opinion
# llm            = trust the LLM's verdicts (better for larger models)
MATCHER_AUTHORITY=rules
# hybrid (default) = model writes only the Medical Necessity paragraph; full = model writes every section
LETTER_STYLE=hybrid

# Local bge-small embeddings for policy search (off = TF-IDF only)
EMBEDDINGS=on

# Pause between pipeline steps (ms) so the agent timeline is readable on stage. Set 0 to disable.
PIPELINE_STEP_DELAY_MS=450
# Mock payer decision delay (ms)
PAYER_DECISION_DELAY_MS=3000

# Assumption behind the "estimated minutes saved" KPI (labelled "est." in the UI)
ESTIMATED_MANUAL_MINUTES_PER_PACKET=45
