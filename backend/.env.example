# Copy to .env and adjust.
PORT=4000
# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise the rule engine
# claude = always use Claude | heuristic = never call an LLM
AI_MODE=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Animation delay between agent steps (ms) and mock payer decision delay (ms)
STEP_DELAY_MS=500
PAYER_DECISION_DELAY_MS=3000

# --- LLM provider: set one key. Mistral is preferred when both are set (or force with AI_PROVIDER) ---
# AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-3b-2512
# rules (default) = rule checks decide criteria verdicts, LLM gives a second opinion
# llm            = trust the LLM's verdicts (better for larger models)
MATCHER_AUTHORITY=rules

# hybrid (default) = model writes only the Medical Necessity paragraph; full = model writes every section
LETTER_STYLE=hybrid

# Local bge-small embeddings for policy search (set to off to use TF-IDF only)
# EMBEDDINGS=on

# --- MongoDB (Atlas or local). Without it, data is stored in backend/data/db.json ---
# Atlas: Database > Connect > Drivers, copy the mongodb+srv:// string and put your password in it.
MONGODB_URI=
MONGODB_DB=prior_auth_copilot
