{
  "name": "prior-auth-copilot-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "postbuild": "node -e \"const fs=require('fs');if(fs.existsSync('.next/standalone')){fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});if(fs.existsSync('public'))fs.cpSync('public','.next/standalone/public',{recursive:true});}\""
  },
  "dependencies": {
    "lucide-react": "^1.54.0",
    "motion": "^12.43.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
